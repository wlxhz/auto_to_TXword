# 业务服务器 Token；如果接口不需要鉴权可不设置。
BUSINESS_API_TOKEN=replace_me

# 业务数据库只读连接（默认数据源）；仅在服务器环境设置，不提交真实值。
GLUCOSE_DATABASE_URL=postgresql://readonly_user:replace_me@db:5432/replace_me

# 腾讯文档个人 Token。仅当 tencent_doc.backend=mcp 时需要。
TENCENT_DOCS_TOKEN=replace_me

# 企业微信机器人 Webhook。仅当 notification.enabled=true 时需要。
WECHAT_WORK_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace_me
