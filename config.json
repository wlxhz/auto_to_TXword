{
  "remote_api": {
    "url": "https://example.invalid/api/glucose-customer-summary",
    "method": "GET",
    "timeout_seconds": 20,
    "retries": 3,
    "backoff_factor": 0.8,
    "headers": {"Accept": "application/json"},
    "token": "${BUSINESS_API_TOKEN:-}",
    "token_header": "Authorization",
    "token_prefix": "Bearer",
    "params": {},
    "json_body": {},
    "data_path": "data.items",
    "allow_single_object": false
  },
  "validation": {
    "allow_empty": false,
    "required_fields": ["sequence", "customer_name", "first_wear_date", "glucose_mean", "glucose_max", "glucose_min"],
    "not_empty_fields": ["sequence", "customer_name", "first_wear_date", "glucose_mean", "glucose_max", "glucose_min"],
    "unique_fields": [],
    "unique_key_sets": [["customer_name", "first_wear_date"]],
    "date_rules": {
      "first_wear_date": {"formats": ["%Y-%m-%d"], "allow_null": false}
    },
    "numeric_rules": {
      "sequence": {"min": 1, "allow_null": false},
      "glucose_mean": {"min": 0, "allow_null": false},
      "glucose_max": {"min": 0, "allow_null": false},
      "glucose_min": {"min": 0, "allow_null": false}
    },
    "ordered_numeric_fields": [["glucose_min", "glucose_mean", "glucose_max"]]
  },
  "followup_schedule": {
    "offset_days": {
      "followup_1h_date": 0,
      "followup_3d_date": 3,
      "followup_first_week_date": 9,
      "pickup_followup_date": 13
    }
  },
  "mapping": {
    "fields": {
      "sequence": "序号",
      "customer_name": "姓名",
      "phone": "电话",
      "first_wear_date": "首次佩戴日期",
      "followup_1h_date": "1小时回访",
      "followup_3d_date": "3天回访",
      "followup_first_week_date": "首次周回访",
      "pickup_followup_date": "取机器回访",
      "glucose_mean": "血糖均值",
      "glucose_max": "血糖最高值",
      "glucose_min": "血糖最低值"
    }
  },
  "tencent_doc": {
    "backend": "mock",
    "document_type": "smartsheet",
    "column_order": [
      "序号", "姓名", "性别", "电话", "是否是糖尿病", "是否服药", "首次佩戴日期",
      "1小时回访", "3天回访", "首次周回访", "取机器回访", "血糖均值",
      "血糖最高值", "血糖最低值", "14天血糖达标情况"
    ],
    "mock": {
      "output_file": "output/tencent_doc_preview.xlsx",
      "sheet_name": "血糖客户汇总"
    },
    "mcp": {
      "endpoint": "https://docs.qq.com/openapi/mcp",
      "token": "${TENCENT_DOCS_TOKEN:-}",
      "timeout_seconds": 30,
      "protocol_version": "2025-03-26"
    },
    "smartsheet": {
      "file_id": "",
      "sheet_id": "",
      "sync_strategy": "review_existing",
      "primary_keys": ["姓名", "首次佩戴日期"],
      "primary_key_types": {"姓名": "text", "首次佩戴日期": "date"},
      "date_timezone_offset_hours": 8,
      "managed_fields": ["序号", "姓名", "电话", "首次佩戴日期", "1小时回访", "3天回访", "首次周回访", "取机器回访", "血糖均值", "血糖最高值", "血糖最低值"],
      "new_record_policy": "skip",
      "ignore_blank_updates": true,
      "batch_size": 100,
      "page_size": 100,
      "field_types": {
        "序号": "integer",
        "姓名": "text",
        "性别": "text",
        "电话": "text",
        "是否是糖尿病": "text",
        "是否服药": "text",
        "首次佩戴日期": "date",
        "1小时回访": "date",
        "3天回访": "date",
        "首次周回访": "date",
        "取机器回访": "date",
        "血糖均值": "number",
        "血糖最高值": "number",
        "血糖最低值": "number",
        "14天血糖达标情况": "text"
      }
    },
    "excel": {
      "file_id": "",
      "sheet_id": "",
      "tool_name": "batch_update_sheet_range",
      "include_header": false,
      "extra_arguments": {}
    }
  },
  "notification": {
    "enabled": false,
    "webhook_url": "${WECHAT_WORK_WEBHOOK:-}",
    "mentioned_list": [],
    "timeout_seconds": 10
  },
  "logging": {
    "file": "logs/task.log",
    "level": "INFO",
    "max_bytes": 5242880,
    "backup_count": 5
  }
}
